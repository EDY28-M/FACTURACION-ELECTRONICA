{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "barryvdh/laravel-dompdf": "^2.2|^3.0",
        "graham-campbell/markdown": "^15.0",
        "guzzlehttp/guzzle": "^7.8",
        "ifsnop/mysqldump-php": "^2.12",
        "imangazaliev/didom": "^2.0",
        "intervention/image": "^2.7",
        "laravel/framework": "^10.0",
        "laravel/helpers": "^1.7",
        "laravel/legacy-factories": "^1.4",
        "laravel/tinker": "^2.9",
        "laravel/ui": "^4.5",
        "laravelcollective/html": "^6.4",
        "league/flysystem-ftp": "^3.0",
        "maatwebsite/excel": "^3.1",
        "mpdf/mpdf": "^8.2",
        "mpdf/qrcode": "^1.2",
        "nwidart/laravel-modules": "^10.0",
        "picqer/php-barcode-generator": "^2.4",
        "rap2hpoutre/laravel-log-viewer": "^2.4",
        "robrichards/xmlseclibs": "^3.1",
        "symfony/process": "^6.4",
        "thiagoalessio/tesseract_ocr": "^2.13",
        "zanysoft/laravel-zip": "^2.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.13",
        "fakerphp/faker": "^1.23",
        "filp/whoops": "^2.15",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^7.10",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "classmap": [
            "database/seeds",
            "database/seeds/tenants",
            "database/factories"
        ],
        "psr-4": {
            "App\\": "app/",
            "Hyn\\Tenancy\\": "app/Tenancy/",
            "Modules\\": "modules/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [
            ]
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ],
        "test:unit": "@php vendor/bin/phpunit --testsuite Unit",
        "lint": "find app modules routes config tests bootstrap -name '*.php' -not -path '*/vendor/*' -print0 | xargs -0 -n 1 php -l"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "audit": {
            "block-insecure": false
        },
        "allow-plugins": {
            "kylekatarnls/update-helper": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
