# High-concurrency MariaDB 10.5 tuning for multi-tenant FacturacionPro (16 GB RAM host).
# Sized for ~100+ tenant databases (~200 tables each) and 400+ active users while leaving
# plenty of RAM for PHP-FPM, Nginx, Caddy, and OS page cache.
# Note: innodb_flush_log_at_trx_commit stays at 1 (strict ACID durability for SUNAT fiscal data).

[mysqld]
# InnoDB buffer pool: keep hot tenant indexes and tables in RAM instead of hitting disk
innodb_buffer_pool_size = 3G
innodb_buffer_pool_instances = 3
innodb_flush_log_at_trx_commit = 1
innodb_flush_method = O_DIRECT

# Concurrency & multi-tenant table caches
max_connections = 300
thread_cache_size = 64
table_open_cache = 8000
table_definition_cache = 4000

# In-memory temporary tables for dashboard / report aggregations & GROUP BY
tmp_table_size = 64M
max_heap_table_size = 64M

# Prevent slow DNS reverse lookups on container connections
skip-name-resolve
